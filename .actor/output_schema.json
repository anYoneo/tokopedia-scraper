{
  "$schema": "https://apify.com/schemas/v1/output.ide.json",
  "actorOutputSchemaVersion": 1,
  "title": "Output schema",
  "properties": {
    "dataset": {
      "type": "string",
      "title": "Produk (dataset lengkap)",
      "template": "{{links.apiDefaultDatasetUrl}}/items"
    },
    "datasetCsv": {
      "type": "string",
      "title": "Produk (CSV)",
      "template": "{{links.apiDefaultDatasetUrl}}/items?format=csv"
    },
    "datasetXlsx": {
      "type": "string",
      "title": "Produk (Excel)",
      "template": "{{links.apiDefaultDatasetUrl}}/items?format=xlsx"
    },
    "ringkasan": {
      "type": "string",
      "title": "Ringkasan jalannya Actor",
      "template": "{{links.apiDefaultKeyValueStoreUrl}}/records/OUTPUT"
    }
  }
}
