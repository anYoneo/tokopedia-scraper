{
  "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
  "actorSpecification": 1,
  "fields": {
    "type": "object",
    "properties": {
      "id": { "type": ["string", "null"], "description": "ID produk di Tokopedia" },
      "nama": { "type": ["string", "null"], "description": "Nama produk" },
      "harga": { "type": ["integer", "null"], "description": "Harga dalam Rupiah" },
      "harga_teks": { "type": ["string", "null"], "description": "Harga seperti tertulis di situs" },
      "harga_asli": { "type": ["integer", "null"], "description": "Harga sebelum diskon" },
      "diskon_pct": { "type": ["integer", "null"], "description": "Persentase diskon" },
      "rating": { "type": ["number", "null"], "description": "Rating rata-rata 1-5" },
      "terjual": { "type": ["integer", "null"], "description": "Jumlah unit terjual" },
      "toko_id": { "type": ["string", "null"] },
      "toko_nama": { "type": ["string", "null"] },
      "toko_kota": { "type": ["string", "null"] },
      "toko_tier": { "type": ["integer", "null"] },
      "toko_url": { "type": ["string", "null"] },
      "kategori": { "type": ["string", "null"] },
      "kategori_jalur": { "type": ["string", "null"] },
      "iklan": { "type": ["boolean", "null"] },
      "url": { "type": ["string", "null"] },
      "gambar": { "type": ["string", "null"] },
      "diambil_pada": { "type": ["string", "null"] }
    }
  },
  "views": {
    "overview": {
      "title": "Produk Tokopedia",
      "transformation": {
        "fields": [
          "nama",
          "harga",
          "diskon_pct",
          "rating",
          "terjual",
          "toko_nama",
          "toko_kota",
          "kategori",
          "url"
        ]
      },
      "display": {
        "component": "table",
        "properties": {
          "nama": { "label": "Produk", "format": "text" },
          "harga": { "label": "Harga (Rp)", "format": "number" },
          "diskon_pct": { "label": "Diskon %", "format": "number" },
          "rating": { "label": "Rating", "format": "number" },
          "terjual": { "label": "Terjual", "format": "number" },
          "toko_nama": { "label": "Toko", "format": "text" },
          "toko_kota": { "label": "Kota", "format": "text" },
          "kategori": { "label": "Kategori", "format": "text" },
          "url": { "label": "Tautan", "format": "link" }
        }
      }
    }
  }
}
